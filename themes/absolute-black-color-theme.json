    "terminal.ansiBlack": "#000000",
    "terminal.ansiBrightBlack": "#303030",
    "terminal.ansiWhite": "#E6E6E6",
    "terminal.background": "#000000",
    "terminal.border": "#1a1a1a",
    "terminal.foreground": "#D6D9DC",
