    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#929292",
    "tree.indentGuidesStroke": "#000000"
  },
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8B949E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#7FB6D6"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D66C63"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#BFA3D6"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "identifier"
      ],
      "settings": {
        "foreground": "#D6D9DC"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#5E9DD6"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#C98B4D"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.property",
        "meta.property-name",
        "support.property"
      ],
      "settings": {
        "foreground": "#5E9DD6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.definition.arguments"
      ],
      "settings": {
        "foreground": "#D66C63"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#5E9DD6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D64545"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#8B949E",
      "fontStyle": "italic"
    },
    "string": {
      "foreground": "#7FB6D6"
    },
    "keyword": {
      "foreground": "#D66C63"
    },
    "number": {
      "foreground": "#5E9DD6"
    },
    "variable": {
      "foreground": "#D6D9DC"
    },
    "variable.readonly": {
      "foreground": "#D6D9DC"
    },
    "parameter": {
      "foreground": "#D6D9DC"
    },
    "property": {
      "foreground": "#5E9DD6"
    },
    "function": {
      "foreground": "#BFA3D6"
    },
    "method": {
      "foreground": "#BFA3D6"
    },
    "class": {
      "foreground": "#C98B4D"
    },
    "type": {
      "foreground": "#C98B4D"
    },
    "namespace": {
      "foreground": "#D66C63"
    },
    "enum": {
      "foreground": "#C98B4D"
    },
    "interface": {
      "foreground": "#C98B4D"
    }
  }
}